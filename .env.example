# --- General Settings ---
# Set DOMAIN to your public domain (e.g., mc-shop.com) or localhost for testing.
# When deploying to production with a real domain, Caddy will automatically
# provision and renew free SSL certificates (HTTPS on port 80/443 and 1420).
DOMAIN=localhost

# --- Backend Settings ---
BACKEND_PORT=5000
NODE_ENV=production
MONGO_URI=mongodb://db:27017/webshopmc
JWT_SECRET=change_this_to_a_secure_random_string

# --- Admin Login Settings ---
# Root admin credentials (defined here in env, NOT stored in database).
# Root has full access to all admin pages and can manage sub-admin users.
# Change these to strong credentials before deploying to production!
ADMIN_ROOT_USER=root
ADMIN_ROOT_PASS=change_this_to_a_secure_password

# --- URL & CORS Settings ---
# If left blank, these will automatically default to:
# - FRONTEND_URL = https://${DOMAIN}
# - API_URL = https://${DOMAIN}/api-backend
# - LAUNCHER_URL = https://${DOMAIN}:1420
# (For local dev without HTTPS, uncomment and change protocol to http)
#FRONTEND_URL=http://localhost
#API_URL=http://localhost/api-backend
#LAUNCHER_URL=http://localhost:1420

# --- Frontend Settings ---
NEXT_PUBLIC_API_URL=/api-backend

# --- Launcher Settings ---
LAUNCHER_PORT=1420

# --- AuthMe MySQL Settings ---
# Connect to AuthMe's MySQL database for Minecraft server login sync.
# When a user registers or changes password on the website,
# it will also update the AuthMe database so they can login to the Minecraft server.
AUTHME_MYSQL_HOST=127.0.0.1
AUTHME_MYSQL_PORT=3306
AUTHME_MYSQL_USER=your_mysql_user
AUTHME_MYSQL_PASSWORD=your_mysql_password
AUTHME_MYSQL_DATABASE=your_authme_database
AUTHME_MYSQL_TABLE=authme

# --- Cloudflare Turnstile Settings ---
# Dummy testing keys are set by default. Replace with your production keys from Cloudflare Dashboard.
# TURNSTILE_SITE_KEY and TURNSTILE_SECRET_KEY can also be overridden/configured directly in the database Settings collection.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

