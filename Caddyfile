{$DOMAIN} {
    # Limit upload size to 100MB
    request_body {
        max_size 100MB
    }

    # Proxy API requests to backend (stripping the /api-backend prefix)
    handle_path /api-backend/* {
        reverse_proxy backend:5000
    }

    # Proxy uploads from backend (preserving the path /uploads/...)
    handle /uploads/* {
        reverse_proxy backend:5000
    }

    # Proxy frontend requests (Next.js server)
    handle {
        reverse_proxy frontend:3000
    }
}

# Proxy launcher web preview on port 1420
{$DOMAIN}:1420 {
    # Limit upload size
    request_body {
        max_size 100MB
    }

    # Proxy API requests (for self-configuring dynamic API calls)
    handle_path /api-backend/* {
        reverse_proxy backend:5000
    }

    # Proxy uploads
    handle /uploads/* {
        reverse_proxy backend:5000
    }

    # Proxy static files served by launcher container
    handle {
        reverse_proxy launcher:80
    }
}
